{
  "name": "@autocell/player",
  "version": "2.1.0",
  "private": true,
  "description": "AutoCell-Player: Web-Komponente <autocell-player> zum Einbinden von Simulationen in Webseiten",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@autocell/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
