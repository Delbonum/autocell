{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCell",
  "version": "2.1.0",
  "identifier": "de.wiskundeknobbel.autocell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoCell",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "WiskundeKnobbel",
    "category": "Education",
    "shortDescription": "Simulation zellulärer Automaten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "acp"
        ],
        "name": "AutoCell-Projekt",
        "description": "AutoCell-Projekt",
        "mimeType": "application/vnd.autocell.project+zip"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
